#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 2 ]; then
  echo "Usage: unpublish NOTE_ID USER_EMAIL [DISPLAY_NAME]"
  exit 1
fi

NOTE_ID="$1"
USER_EMAIL="$2"
DISPLAY_NAME="${3:-}"

curl -sS -X POST http://127.0.0.1:8090/unpublish \
  -H "Content-Type: application/json" \
  -d "{\"note_id\":\"${NOTE_ID}\",\"user_email\":\"${USER_EMAIL}\",\"display_name\":\"${DISPLAY_NAME}\"}" | jq .
